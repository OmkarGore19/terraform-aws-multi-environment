
# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
*.plan

# Terraform crash logs
crash.log
crash.*.log

# Sensitive Terraform variable files
*.tfvars
*.tfvars.json
!example.tfvars

# AWS credentials
.aws/
credentials
config

# SSH private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Environment files
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db

# Keep Terraform dependency lock file
!.terraform.lock.hcl
